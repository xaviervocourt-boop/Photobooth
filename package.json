{
  "name": "photobooth",
  "productName": "Photobooth",
  "version": "1.4.1",
  "description": "Photobooth : webcam ou appareil photo Nikon / Canon avec flash, cadres PNG et envoi par mail.",
  "author": "Photobooth",
  "main": "desktop/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "build": {
    "appId": "fr.photobooth.app",
    "productName": "Photobooth",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "index.html",
      "styles.css",
      "manifest.webmanifest",
      "js/**",
      "icons/**",
      "desktop/**",
      "package.json",
      "!node_modules/koffi/{src,vendor,doc,lib}/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}",
      "!node_modules/koffi/**/*.{md,ts}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Photobooth",
      "artifactName": "Photobooth-Setup-${version}.exe"
    },
    "linux": {
      "target": "dir"
    },
    "publish": null,
    "asarUnpack": [
      "desktop/camera/**",
      "node_modules/koffi/**"
    ],
    "npmRebuild": false
  },
  "dependencies": {
    "koffi": "2.16.3"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  }
}
